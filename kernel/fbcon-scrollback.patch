+/*
+ * Screen history used by con_scrolldelta() (Shift+PageUp / Shift+PageDown).
+ *
+ * fbcon has no con_scrolldelta implementation, so the VT layer silently
+ * ignores scrollback requests on framebuffer consoles.  Keep the lines that
+ * scroll off the top of the screen in a ring buffer and repaint the console
+ * from it when the VT layer asks for a scroll delta.
+ */
+#define FBCON_SB_LINES	4096
+
+static u16 *fbcon_sb_buf;		/* FBCON_SB_LINES lines of fbcon_sb_cols */
+static unsigned int fbcon_sb_cols;	/* columns of a stored line */
+static unsigned int fbcon_sb_head;	/* next slot to write */
+static unsigned int fbcon_sb_count;	/* valid slots in the ring */
+static int fbcon_sb_back;		/* lines currently scrolled back */
+static bool fbcon_sb_drawing;		/* set while repainting from history */
+
+static void fbcon_putcs(struct vc_data *vc, const u16 *s, unsigned int count,
+			unsigned int ypos, unsigned int xpos);
+static void fbcon_cursor(struct vc_data *vc, bool enable);
+
+/*
+ * (Re)allocate the history buffer when the console width changes.  Only ever
+ * called from sleepable contexts (fbcon_init/fbcon_resize), never while
+ * outputting, so that fbcon_scroll() itself never has to allocate.
+ */
+static void fbcon_sb_ensure_cols(unsigned int cols)
+{
+	if (!cols || (fbcon_sb_buf && fbcon_sb_cols == cols))
+		return;
+
+	kfree(fbcon_sb_buf);
+	fbcon_sb_buf = kmalloc_array(FBCON_SB_LINES, cols * sizeof(u16),
+				     GFP_KERNEL);
+	fbcon_sb_cols = fbcon_sb_buf ? cols : 0;
+	fbcon_sb_head = 0;
+	fbcon_sb_count = 0;
+	fbcon_sb_back = 0;
+}
+
 static struct device *fbcon_device;
 
