+/*
+ * Save the lines that are about to leave the top of the screen.  Must run
+ * before fbcon_scroll() rewrites vc_origin.
+ */
+static void fbcon_sb_store(struct vc_data *vc, unsigned int line,
+			   unsigned int count)
+{
+	unsigned int stride = vc->vc_size_row / 2;
+	unsigned short *src = (unsigned short *)vc->vc_origin +
+		stride * line;
+	unsigned int i;
+
+	if (!fbcon_sb_buf || fbcon_sb_cols != vc->vc_cols || !count)
+		return;
+	if (count > FBCON_SB_LINES)
+		count = FBCON_SB_LINES;
+
+	for (i = 0; i < count; i++) {
+		memcpy(&fbcon_sb_buf[fbcon_sb_head * fbcon_sb_cols],
+		       src + stride * i, fbcon_sb_cols * sizeof(u16));
+		fbcon_sb_head = (fbcon_sb_head + 1) % FBCON_SB_LINES;
+		if (fbcon_sb_count < FBCON_SB_LINES)
+			fbcon_sb_count++;
+	}
+}
+
+/* Repaint the whole console: history lines first, then the live content. */
+static void fbcon_sb_redraw(struct vc_data *vc)
+{
+	unsigned int rows = vc->vc_rows;
+	unsigned int cols = vc->vc_cols;
+	unsigned int r;
+
+	if (!fbcon_sb_buf || fbcon_sb_cols != cols)
+		fbcon_sb_back = 0;
+	if (fbcon_sb_back > (int)fbcon_sb_count)
+		fbcon_sb_back = fbcon_sb_count;
+
+	fbcon_sb_drawing = true;
+	for (r = 0; r < rows; r++) {
+		const u16 *row;
+		unsigned int x = 0;
+
+		if (r < (unsigned int)fbcon_sb_back) {
+			unsigned int idx = fbcon_sb_count - fbcon_sb_back + r;
+
+			row = &fbcon_sb_buf[idx * cols];
+		} else {
+			row = (const u16 *)(vc->vc_origin +
+					   vc->vc_size_row *
+					   (r - fbcon_sb_back));
+		}
+
+		/* one putcs() run per attribute, like fbcon_redraw() does */
+		while (x < cols) {
+			unsigned int start = x;
+			u16 attr = row[x] & 0xff00;
+
+			while (x < cols && (row[x] & 0xff00) == attr)
+				x++;
+			fbcon_putcs(vc, &row[start], x - start, r, start);
+		}
+	}
+	fbcon_sb_drawing = false;
+	fbcon_clear_margins(vc, 0);
+}
+
+/* New console output: drop the history view and show the live screen. */
+static void fbcon_sb_live(struct vc_data *vc)
+{
+	if (fbcon_sb_drawing || !fbcon_sb_back)
+		return;
+
+	fbcon_sb_back = 0;
+	fbcon_sb_redraw(vc);
+}
+
+static void fbcon_scrolldelta(struct vc_data *vc, int lines)
+{
+	int newback;
+
+	if (!con_is_visible(vc) || vc->vc_mode != KD_TEXT)
+		return;
+
+	if (!fbcon_sb_buf || fbcon_sb_cols != vc->vc_cols) {
+		fbcon_sb_live(vc);
+		return;
+	}
+
+	/* lines == 0 means "restore the live screen" */
+	newback = lines ? fbcon_sb_back - lines : 0;
+	if (newback < 0)
+		newback = 0;
+	if (newback > (int)fbcon_sb_count)
+		newback = fbcon_sb_count;
+	if (newback == fbcon_sb_back)
+		return;
+
+	fbcon_sb_back = newback;
+	fbcon_sb_redraw(vc);
+	if (!fbcon_sb_back)
+		fbcon_cursor(vc, true);
+}
+
 static void fbcon_clear(struct vc_data *vc, unsigned int sy, unsigned int sx,
 			unsigned int width)
 {
+	fbcon_sb_live(vc);
 	__fbcon_clear(vc, sy, sx, 1, width);
 }
 
