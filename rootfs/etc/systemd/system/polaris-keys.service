[Unit]
Description=Polaris console key handling (power backlight, volume tap/hold)
# logind must have applied its HandlePowerKey=ignore drop-in first, otherwise it
# EVIOCGRABs the power key device and this daemon never sees any event.
After=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/sbin/polaris-keys
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
